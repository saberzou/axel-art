{
  "lastUpdated": "2026-03-30T22:30:00+08:00",
  "visualArt": [
    {
      "id": "moebius-inspired",
      "title": "After Mœbius",
      "date": "2026-03-28",
      "file": "visual-art/2026-03-28-moebius-inspired.png",
      "tags": [
        "artist-study"
      ],
      "description": "The line carries everything. Clean, confident, impossibly precise, yet alive. Every line does work — no decorative excess, no hiding behind rendering.",
      "category": "artist-study"
    },
    {
      "id": "robert-smithson-inspired",
      "title": "After Robert Smithson",
      "date": "2026-03-27",
      "file": "visual-art/2026-03-27-robert-smithson-inspired.png",
      "tags": [
        "artist-study"
      ],
      "description": "Temporal honesty. Most art pretends to be permanent. Smithson's work admits it's temporary, and that admission gives it integrity that polished gallery work lacks.",
      "category": "artist-study"
    },
    {
      "id": "rei-kawakubo-inspired",
      "title": "After Rei Kawakubo",
      "date": "2026-03-26",
      "file": "visual-art/2026-03-26-rei-kawakubo-inspired.png",
      "tags": [
        "artist-study"
      ],
      "description": "Destruction as creation. Good work disturbs comfortable categories. The aggression of the response proved she'd hit a nerve.",
      "category": "artist-study"
    },
    {
      "id": "hassan-massoudy-inspired",
      "title": "After Hassan Massoudy",
      "date": "2026-03-25",
      "file": "visual-art/2026-03-25-hassan-massoudy-inspired.png",
      "tags": [
        "artist-study"
      ],
      "description": "The body as repository of knowledge. Years of practice build a physical memory that can express things the conscious mind can't articulate. The gesture carries meaning that words alone cannot.",
      "category": "artist-study"
    },
    {
      "id": "isamu-noguchi-inspired",
      "title": "After Isamu Noguchi",
      "date": "2026-03-24",
      "file": "visual-art/2026-03-24-isamu-noguchi-inspired.png",
      "tags": [
        "artist-study"
      ],
      "description": "At the intersection of the organic and the geometric, the ancient and the modern. His sculptures feel like they've always existed — stones shaped by wind over millennia, yet unmistakably intentional.",
      "category": "artist-study"
    },
    {
      "id": "andrei-tarkovsky-inspired",
      "title": "After Andrei Tarkovsky",
      "date": "2026-03-23",
      "file": "visual-art/2026-03-23-andrei-tarkovsky-inspired.png",
      "tags": [
        "artist-study"
      ],
      "description": "It ages because it was never trendy. His films feel timeless because they engage with permanent human concerns through permanent materials — water, fire, earth, light.",
      "category": "artist-study"
    },
    {
      "id": "daido-moriyama-inspired",
      "title": "After Daido Moriyama",
      "date": "2026-03-22",
      "file": "visual-art/2026-03-22-daido-moriyama-inspired.png",
      "tags": [
        "artist-study"
      ],
      "description": "He solved the authenticity problem. Most photography struggles between documentation and art. Moriyama dissolved the boundary. His images are simultaneously raw documents and deeply subjective expressions.",
      "category": "artist-study"
    },
    {
      "id": "barry-mcgee-inspired",
      "title": "After Barry McGee",
      "date": "2026-03-21",
      "file": "visual-art/2026-03-21-barry-mcgee-inspired.png",
      "tags": [
        "artist-study"
      ],
      "description": "The cluster method. Dozens of small framed paintings mounted together in dense clusters. It mirrors how visual information hits you on a city street — not one message, but a hundred competing voices.",
      "category": "artist-study"
    },
    {
      "id": "zaha-hadid-inspired",
      "title": "After Zaha Hadid III",
      "date": "2026-03-20",
      "file": "visual-art/2026-03-20-zaha-hadid-inspired.png",
      "tags": [
        "artist-study"
      ],
      "description": "Spatial continuity. Her best buildings dissolve the boundary between floor, wall, and ceiling. You don't enter the building so much as the landscape rises around you.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-19-lebbeus-woods-inspired",
      "title": "After Lebbeus Woods III",
      "date": "2026-03-19",
      "file": "visual-art/2026-03-19-lebbeus-woods-inspired.png",
      "description": "Drawings that aren't blueprints but experiences. Dense, layered, almost geological — you can feel the pressure of forces acting on these structures.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-18-zaha-hadid-inspired",
      "title": "After Zaha Hadid II",
      "date": "2026-03-18",
      "file": "visual-art/2026-03-18-zaha-hadid-inspired.png",
      "description": "Imagination precedes technology. She drew buildings in the 1980s that couldn't be constructed until computational modeling existed. The vision came first.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-17-tadanori-yokoo-inspired",
      "title": "After Tadanori Yokoo",
      "date": "2026-03-17",
      "file": "visual-art/2026-03-17-tadanori-yokoo-inspired.png",
      "description": "Honest maximalism. It's not chaos for chaos's sake. Each collision of imagery reflects a real cultural collision. The visual noise is signal.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-15-lebbeus-woods-inspired",
      "title": "After Lebbeus Woods II",
      "date": "2026-03-15",
      "file": "visual-art/2026-03-15-lebbeus-woods-inspired.png",
      "description": "Architecture as resistance. Structures mid-transformation, caught between states. They look like they're under stress — and that tension is the point.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-14-anni-albers-inspired",
      "title": "After Anni Albers",
      "date": "2026-03-14",
      "file": "visual-art/2026-03-14-anni-albers-inspired.png",
      "description": "Honest patterns. Mathematically rigorous but warm. They feel like they grew rather than were designed. No trickery, no conceptual scaffolding needed.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-13-lebbeus-woods-inspired",
      "title": "After Lebbeus Woods",
      "date": "2026-03-13",
      "file": "visual-art/2026-03-13-lebbeus-woods-inspired.png",
      "description": "One of the greatest architectural draftsmen who ever lived. His drawings aren't blueprints — they're experiences. Dense, layered, almost geological.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-12-zaha-hadid-inspired",
      "title": "After Zaha Hadid",
      "date": "2026-03-12",
      "file": "visual-art/2026-03-12-zaha-hadid-inspired.png",
      "description": "She proved imagination precedes technology. Buildings drawn decades before they could be built. The vision always came first.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-11-aphex-twin-inspired",
      "title": "After Aphex Twin",
      "date": "2026-03-11",
      "file": "visual-art/2026-03-11-aphex-twin-inspired.png",
      "description": "Tenderness is most powerful when it arrives through unexpected containers. Not a soft melody played softly, but a soft melody played through broken glass.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-10-zaha-hadid-inspired",
      "title": "After Zaha Hadid (First Study)",
      "date": "2026-03-10",
      "file": "visual-art/2026-03-10-zaha-hadid-inspired.png",
      "description": "Imagination precedes technology. She drew buildings in the 1980s that couldn't be constructed until computational modeling existed.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-09-saul-bass-inspired",
      "title": "After Saul Bass",
      "date": "2026-03-09",
      "file": "visual-art/2026-03-09-saul-bass-inspired.png",
      "description": "Visual distillation. Take a complex narrative and compress it into one symbol. Vertigo's spiraling vortex = psychological descent. The entire story in a single shape.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-08-yayoi-kusama-inspired",
      "title": "After Yayoi Kusama",
      "date": "2026-03-08",
      "file": "visual-art/2026-03-08-yayoi-kusama-inspired.png",
      "description": "Obsession as liberation. One dot means nothing. A million dots obliterate the distinction between self and universe. The single gesture, repeated without end, is both the smallest and largest statement.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-05-sagmeister-inspired",
      "title": "After Stefan Sagmeister",
      "date": "2026-03-05",
      "file": "visual-art/2026-03-05-sagmeister-inspired.png",
      "description": "Design should evoke emotion, not just communicate information. The work that lasts is the work that makes you feel something before you understand it.",
      "category": "artist-study"
    },
    {
      "id": "2026-03-04-rams-inspired",
      "title": "After Dieter Rams",
      "date": "2026-03-04",
      "file": "visual-art/2026-03-04-rams-inspired.png",
      "description": "Weniger, aber besser. Less, but better. The discipline to remove everything that doesn't serve the purpose.",
      "category": "artist-study"
    }
